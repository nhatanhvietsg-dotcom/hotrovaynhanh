# Preview is the default. Never put server secrets in public/ or src/config.js.
LEAD_MODE=demo
GTM_ID=
GA_ID=
META_PIXEL_ID=
# Enable live only after src/config.js legalApproved=true and official policies are ready.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
CONSENT_VERSION=
# Must accurately identify recipients and the actual data processing purpose.
CONSENT_NOTICE=

# Netlify email mode: set secrets in hosting, Functions scope, production context.
# Use LEAD_MODE=email only after SMTP and CONSENT_NOTICE are configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
LEAD_RECEIVER_EMAIL=
